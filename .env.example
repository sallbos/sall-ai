# Core Application
NODE_ENV=production
APP_URL=https://mrsall.ai
ADMIN_SECRET_KEY=sall_secret_admin_key_change_in_production_2026
JWT_SECRET=super_secure_jwt_secret_mrsall_ai_9823482734

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_R2_BUCKET_NAME=mrsall-ai-storage

# AI Provider Configuration (Modular: Gemini, OpenAI, or Workers AI)
# Primary: Google Gemini API (Recommended for ultra-fast, multimodal & vision support)
GEMINI_API_KEY=AIzaSy_YOUR_REAL_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI API Key (if preferred as primary or fallback)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

# Stripe Billing & Subscriptions (Configurable)
STRIPE_PUBLIC_KEY=pk_test_YOUR_STRIPE_PUBLIC_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
STRIPE_PRICE_ID_PREMIUM_MONTHLY=price_12345_monthly
STRIPE_PRICE_ID_PREMIUM_ANNUAL=price_67890_annual

# Usage Quotas (Server-side enforced)
DAILY_FREE_LIMIT_MESSAGES=20
DAILY_FREE_LIMIT_IMAGES=10
DAILY_PREMIUM_LIMIT_MESSAGES=1000
DAILY_PREMIUM_LIMIT_IMAGES=500
